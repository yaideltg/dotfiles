# Replaces the vendor /usr/lib/systemd/user/emacs.service so the daemon starts
# with the graphical session and inherits WAYLAND_DISPLAY (Fedora's Emacs is PGTK)
[Unit]
Description=Emacs text editor (daemon)
Documentation=info:emacs man:emacs(1) https://gnu.org/software/emacs/
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=notify
ExecStart=/usr/bin/emacs --fg-daemon
# Emacs exits with status 15 after SIGTERM, systemd's default KillSignal
SuccessExitStatus=15
Restart=on-failure
# The first start installs and byte-compiles all packages, far beyond the 45s default
TimeoutStartSec=15min

[Install]
WantedBy=graphical-session.target
