{{- /* chezmoi:modify-template */ -}}
{{- /* Set the keys listed in .chezmoidata/claude.yaml, keep everything else. On a fresh machine the file (and ~/.claude) won't exist yet */ -}}
{{- $current := dict -}}
{{- $raw := trim .chezmoi.stdin -}}
{{- if $raw -}}
{{-   $current = fromJson $raw -}}
{{- end -}}
{{- $merged := deepCopy $current -}}
{{- range $key, $value := .claude.settings -}}
{{-   if eq $key "env" -}}
{{-     $env := dict -}}
{{-     if hasKey $merged "env" -}}
{{-       $env = get $merged "env" -}}
{{-     end -}}
{{-     range $name, $val := $value -}}
{{-       $_ := set $env $name $val -}}
{{-     end -}}
{{-     $_ := set $merged "env" $env -}}
{{-   else -}}
{{-     $_ := set $merged $key $value -}}
{{-   end -}}
{{- end -}}
{{- /* Already as wanted: keep the file byte for byte, so Claude Code's key order doesn't show up as a diff */ -}}
{{- if and $raw (eq (toJson $merged) (toJson $current)) -}}
{{ .chezmoi.stdin }}
{{- else -}}
{{ toPrettyJson "  " $merged }}
{{- end -}}
