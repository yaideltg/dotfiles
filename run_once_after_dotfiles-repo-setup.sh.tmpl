{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") .personal -}}
#!/bin/bash
set -euo pipefail

REPO={{ .chezmoi.sourceDir | quote }}

# Run the tracked gitleaks pre-commit hook in .githooks/
git -C "$REPO" config core.hooksPath .githooks

# The first clone uses HTTPS (no SSH key yet); push over SSH from now on
URL="$(git -C "$REPO" remote get-url origin 2>/dev/null || true)"
if [[ "$URL" =~ ^https://github\.com/([^/]+/[^/]+?)(\.git)?$ ]]; then
    git -C "$REPO" remote set-url origin "git@github.com:${BASH_REMATCH[1]}.git"
    echo "Dotfiles remote switched to SSH."
fi
{{ end -}}
