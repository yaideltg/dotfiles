{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") .personal -}}
#!/bin/bash
set -euo pipefail

# Rerun whenever the settings change
# dconf hash: {{ includeTemplate "gnome-dconf.ini" . | sha256sum }}

if ! command -v dconf &>/dev/null || [[ "${XDG_CURRENT_DESKTOP:-}" != *GNOME* ]]; then
    echo "Not in a GNOME session, skipping GNOME settings (rerun chezmoi apply from a GNOME terminal)."
    exit 0
fi

echo "Loading GNOME settings..."
dconf load / <<'DCONF_EOF'
{{ includeTemplate "gnome-dconf.ini" . }}
DCONF_EOF
{{ end -}}
