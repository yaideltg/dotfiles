{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") .personal -}}
#!/bin/bash
set -euo pipefail

# Rerun whenever the tool list changes
# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }} {{ .install_node }}

export PATH="$HOME/.local/bin:$PATH"

echo "Installing mise tools..."
mise install
{{ end -}}
